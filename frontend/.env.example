# Local backend (no proxy):
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Hosted / Vercel — browser calls the Next.js proxy; server talks to Render:
NEXT_PUBLIC_API_URL=/api/backend
API_URL=https://route-53-assignment.onrender.com
# Server-only. Used by /api/amazon-q (never prefix with NEXT_PUBLIC_).
OPENAI_API_KEY=
